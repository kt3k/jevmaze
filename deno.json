{
  "nodeModulesDir": "auto",
  "tasks": {
    "build:static": "mkdir -p dist && cp static/* dist/",
    "build:css": "deno run -A npm:@tailwindcss/cli -i src/styles.css -o dist/styles.css --minify",
    "build:js": "deno bundle --platform browser --minify -o dist/app.js src/main.ts",
    "build": "deno task build:static && deno task build:css && deno task build:js",
    "dev": "deno task build && deno run --allow-net --allow-env --allow-read --watch main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "check": "deno check main.ts src/main.ts",
    "test": "deno test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/http": "jsr:@std/http@^1",
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3",
    "@typesafe-ai/sdk": "npm:@typesafe-ai/sdk@^0.6.0",
    "basecoat-css": "npm:basecoat-css@^1.0.2",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "fmt": { "exclude": ["dist/"] },
  "lint": { "exclude": ["dist/"] }
}
